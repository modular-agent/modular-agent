{
  "id": "echo",
  "name": "Echo",
  "agents": [
    {
      "id": "in",
      "def_name": "modular_agent_core::external_agent::ExternalInputAgent",
      "outputs": ["value"],
      "configs": { "name": "input" }
    },
    {
      "id": "out",
      "def_name": "modular_agent_core::external_agent::ExternalOutputAgent",
      "inputs": ["value"],
      "configs": { "name": "output" }
    }
  ],
  "connections": [
    {
      "source": "in",
      "source_handle": "value",
      "target": "out",
      "target_handle": "value"
    }
  ]
}

{
  "name": "modular-agent-std-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Custom node UIs (NodeView / ConfigWidget) for the modular-agent-std example agents. Distributed as Svelte source; composed into modular-agent-desktop at build time by vite-plugin-agent-ui.",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9"
  },
  "peerDependencies": {
    "@modular-agent/widget-kit": "*",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@modular-agent/widget-kit": {
      "optional": true
    }
  }
}

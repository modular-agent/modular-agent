{
  "modules": [
    {
      "id": "1",
      "def_name": "modular_agent_std::time::ScheduleTimerModule",
      "outputs": [
        "time"
      ],
      "configs": {
        "schedule": "*/10 * * * * *"
      },
      "x": 0,
      "y": 0
    },
    {
      "id": "2",
      "def_name": "modular_agent_std::log::LogModule",
      "inputs": [
        "value"
      ],
      "configs": {
        "level": "info",
        "message": "tick {{value}}"
      },
      "x": 240,
      "y": 0
    }
  ],
  "connections": [
    {
      "source": "1",
      "source_handle": "time",
      "target": "2",
      "target_handle": "value"
    }
  ]
}
